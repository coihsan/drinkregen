---
import { getProductVariant } from "@/lib/product-catalog";
import ProductBreadcrumb from "@/src/components/product/ProductBreadcrumb";
import RelatedProducts from "@/src/components/product/RelatedProducts";
import Layout from "../../../../layouts/Layout.astro";
import { DetailProductAvailableByVariant } from "@/lib/product-availability";
import BannerBuyProductRegenByItem from "@/src/components/product/BannerBuyProductRegenByItem";
import BannerHeader from "@/src/components/BannerHeader";
import ProductDetail300ml from "@/src/components/product/ProductDetail300ml";
import { generateRegenProductSchema } from "@/utils/seo";

const productId = "lemonlime";
const productSize = "300ml";

const data = getProductVariant(productSize, productId)!;
const DetailProductAvailable =
  DetailProductAvailableByVariant[productSize][productId];

const productSchema = generateRegenProductSchema({
  size: productSize,
  flavorId: productId,
  pageUrl: Astro.url.href,
  siteUrl: Astro.site?.href,
});
---

<Layout
  title="Regen Lemon Lime - Mood Booster"
  description="Bebas Gula, Manis Alami, Stevia dan Tanpa bahan pengawet."
  schemaData={productSchema}
  openGraph={{
    title: "Regen Lemon Lime - Mood Booster",
    description: "Bebas Gula, Manis Alami, Stevia dan Tanpa bahan pengawet.",
    images: [
      {
        url: "/og-image-regen.jpg",
        width: 1200,
        height: 630,
        alt: "Regen Lemon Lime - Mood Booster",
      },
    ],
  }}
>
  <BannerHeader
    client:load
    content={[
      {
        type: "image",
        desktopImageUrl: "/banner-product/lemonlime-desktop.webp",
        tabletImageUrl: "/banner-product/lemonlime-desktop.webp",
        mobileImageUrl: "/banner-product/lemonlime-mobile.webp",
        alt: "Banner product regen",
      },
    ]}
  />
  <div class="container">
    <ProductBreadcrumb client:load product={data} />
    <ProductDetail300ml
      client:load
      vitaminColor={data.vitaminColor}
      vitaminContent={data.vitamin}
      productName={data.displayName}
      productUSP={data.usp}
      productComp={data.komposisi}
      description={data.description}
      nutritionFacts={data.nutritionFacts}
      vitaminFacts={data.vitaminFacts}
      titleColor={data.titleColor}
      sourceImage={data.bottleImage}
    />
    <RelatedProducts product={data} />
  </div>
  <BannerBuyProductRegenByItem client:load content={DetailProductAvailable} />
</Layout>
