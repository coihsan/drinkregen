---
import { Image } from "astro:assets";
import { StepMendapatkanHadiah } from "@/lib/umroh";
import BannerHeader from "@/src/components/BannerHeader.tsx";
import Layout from "@/src/layouts/Layout.astro";
import FAQTNC from "@/src/components/FAQTNC.tsx";

const title = "REGEN Berhadiah Umroh & Uang Tunai — Buka REGEN, Buka Rejeki";
const description = "Ikuti program Buka REGEN, Buka Rejeki. Temukan kode unik pada REGEN 300ml berkemasan khusus dan cek kesempatan hadiah umroh 2 orang serta uang tunai jutaan rupiah.";
const bannerContent = [
  {
    type: "image" as const,
    desktopImageUrl: "/banner-umroh-desktop.webp",
    tabletImageUrl: "/slide-1-tablet.jpg",
    mobileImageUrl: "/slide-1-mobile.jpg",
    alt: "Banner product regen",
  },
];
const stepTitles = ["Beli REGEN", "Buka tutupnya", "Scan QR-nya", "Klaim hadiahnya"];
---

<Layout title={title} description={description} openGraph={{ title, description, url: "https://drinkregen.com/regen-berhadiah-umroh", images: [{ url: "https://drinkregen.com/banner-umroh-desktop.webp", alt: "Program REGEN berhadiah umroh dan uang tunai" }] }}>
  <article class="umroh-page" lang="id">
    <BannerHeader client:load content={bannerContent} />

    <section class="code-section" aria-labelledby="code-title">
      <div class="code-copy"><p class="eyebrow">BUKA REGEN, BUKA REJEKI</p><h1 id="code-title">Punya kode unik?<br /><span>Buka peluang rejekimu.</span></h1><p>Temukan kode unik di balik tutup botol REGEN berkemasan khusus, lalu cek kodemu di situs program.</p></div>
      <div class="code-action"><a class="promo-button lime" href="https://regen.satu.app" target="_blank" rel="noopener noreferrer">Cek Kode Unikmu <span aria-hidden="true">↗</span><span class="sr-only"> (buka tab baru)</span></a><span class="domain">regen.satu.app</span><a class="text-link" href="#cara-ikut">Belum tahu caranya? Lihat di sini <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="prize-section section-pad" aria-labelledby="prize-title">
      <div class="section-heading"><div><p class="eyebrow">SEGARNYA DAPAT. REJEKINYA MENDEKAT.</p><h2 id="prize-title">Dari balik tutup botol,<br /><span>ada cerita istimewa.</span></h2></div><div class="period"><span class="period-icon" aria-hidden="true">✳</span><div><span>PERIODE PROGRAM</span><strong>31 Maret – 31 Desember 2026</strong></div></div></div>
      <div class="prize-grid">
        <div class="prize-card umroh-prize"><div><p class="eyebrow">HADIAH UMROH</p><h3>Perjalanan bermakna.<br />Lebih indah berdua.</h3><p>Kesempatan mendapatkan hadiah umroh untuk 2 orang.</p></div><div class="prize-number" aria-label="2 orang"><strong>2</strong><span>ORANG</span></div><span class="prize-spark" aria-hidden="true">✳</span></div>
        <div class="prize-card cash-prize"><p class="eyebrow">HADIAH UANG TUNAI</p><h3>Segarnya REGEN.<br />Manisnya rejeki.</h3><div class="cash-value">Jutaan<span>rupiah</span></div></div>
      </div>
      <p class="prize-note"><span aria-hidden="true">ⓘ</span> Tidak semua kode unik memiliki hadiah. Hadiah mengikuti kode unik dan ketentuan program.</p>
    </section>

    <section class="steps-section section-pad" id="cara-ikut" aria-labelledby="steps-title">
      <div class="section-heading"><div><p class="eyebrow">EMPAT LANGKAH MENUJU KEJUTAN</p><h2 id="steps-title">Buka. Cek.<br /><span>Siap-siap dapat rejeki.</span></h2></div><p class="section-description">Cara mendapatkan hadiah dimulai dari REGEN 300ml berkemasan khusus favoritmu.</p></div>
      <ol class="steps-grid">{StepMendapatkanHadiah.map((item, index) => <li class="step-card"><div class="step-top"><span>LANGKAH</span><strong>0{index + 1}</strong></div><div class="step-image"><Image src={item.sourceImg} width={300} height={300} alt={item.title} loading="lazy" /></div><h3>{stepTitles[index]}</h3><p>{item.title}</p></li>)}</ol>
      <div class="keep-packaging"><span class="keep-icon" aria-hidden="true">!</span><div><h3>Simpan botol &amp; tutupnya, ya.</h3><p>Jika klaim berhasil, simpan kemasan dan tutup botol yang memuat kode unik untuk verifikasi klaim hadiah lebih lanjut.</p></div><a href="#syarat-ketentuan">Baca ketentuannya <span aria-hidden="true">↗</span></a></div>
    </section>

    <section class="faq-section section-pad" id="syarat-ketentuan" aria-labelledby="faq-title">
      <div class="faq-heading"><p class="eyebrow">BIAR MAKIN JELAS</p><h2 id="faq-title">Kenali promonya.<br /><span>Pahami ketentuannya.</span></h2><p>Semua yang perlu kamu tahu sebelum mengikuti program Buka REGEN, Buka Rejeki.</p><span class="faq-decoration" aria-hidden="true">?</span></div>
      <div class="faq-panel"><FAQTNC client:load /></div>
    </section>

    <section class="closing-section" aria-labelledby="closing-title"><div><p class="eyebrow">SUDAH CEK BALIK TUTUP BOTOLMU?</p><h2 id="closing-title">Segarnya dinikmati.<br />Kode uniknya dicek.</h2></div><a class="promo-button dark" href="https://regen.satu.app" target="_blank" rel="noopener noreferrer">Cek Kode Unikmu <span aria-hidden="true">↗</span><span class="sr-only"> (buka tab baru)</span></a></section>
  </article>
</Layout>

<style>
  .umroh-page{
    --ink:var(--regen-ink);
    --lime:var(--regen-citrus);
    --paper:var(--regen-paper);
    background:var(--paper);
    color:var(--ink);
    font-family:Arial,Helvetica,sans-serif;
    overflow:clip
}
.umroh-page h1,.umroh-page h2,.umroh-page h3{
    font-family:var(--font-headoh),Arial,sans-serif;
    font-weight:400;
    line-height:1;
    margin:0
}
.umroh-page p{
    margin:0
}
.eyebrow{
    font-size:10px;
    font-weight:800;
    line-height:1.6
}
.section-pad{
    padding:85px 6vw
}
.umroh-page a:focus-visible{
    outline:3px solid var(--regen-red-dark);
    outline-offset:5px
}
.code-section{
    background:var(--ink);
    color:var(--paper);
    display:grid;
    grid-template-columns:1.6fr 1fr;
    gap:7vw;
    padding:55px 6vw;
    align-items:center
}
.code-copy .eyebrow{
    color:var(--lime)
}
.code-copy h1{
    font-size:clamp(32px,3.4vw,49px);
    margin:18px 0
}
.code-copy h1 span{
    color:var(--lime)
}
.code-copy>p:last-child{
    font-size:15px;
    line-height:1.8;
    max-width:570px
}
.code-action{
    display:flex;
    align-items:center;
    flex-direction:column
}
.promo-button{
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:35px;
    padding:20px 28px;
    border-radius:50px;
    font-size:15px;
    font-weight:bold;
    text-decoration:none;
    transition:transform .2s,box-shadow .2s
}
.promo-button:hover{
    transform:translateY(-3px);
    box-shadow:0 8px 22px #0002
}
.promo-button>span[aria-hidden]{
    font-size:25px;
    line-height:1
}
.lime{
    background:var(--lime);
    color:var(--ink)
}
.dark{
    background:var(--ink);
    color:var(--paper)
}
.domain{
    font-size:11px;
    margin-top:12px;
    color:var(--regen-citrus)
}
.text-link{
    font-size:12px;
    text-underline-offset:5px;
    margin-top:27px
}
.text-link span{
    margin-left:8px
}
.section-heading{
    display:flex;
    justify-content:space-between;
    align-items:end;
    gap:40px;
    margin-bottom:38px
}
.section-heading h2,.faq-heading h2{
    font-size:clamp(33px,3.7vw,54px);
    margin-top:18px
}
.section-heading h2 span,.faq-heading h2 span{
    color:var(--regen-muted)
}
.period{
    display:flex;
    align-items:center;
    gap:14px;
    border:1px solid var(--regen-ink-a30);
    border-radius:10px;
    padding:18px;
    flex-shrink:0
}
.period-icon{
    font-size:34px;
    line-height:1
}
.period div{
    display:flex;
    flex-direction:column;
    gap:7px
}
.period div>span{
    font-size:9px;
}
.period strong{
    font-size:12px
}
.prize-grid{
    display:grid;
    grid-template-columns:1.4fr 1fr;
    gap:22px
}
.prize-card{
    border-radius:16px;
    padding:35px;
    position:relative;
    overflow:hidden;
    min-height:290px
}
.prize-card h3{
    font-size:28px;
    margin:20px 0;
    color:var(--regen-ink)
}
.prize-card p:not(.eyebrow){
    font-size:14px;
    line-height:1;
}
.umroh-prize{
    background:var(--regen-surface);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px
}
.prize-number{
    display:flex;
    flex-direction:column;
    align-items:center;
    align-self:center;
    z-index:1
}
.prize-number strong{
    font-family:var(--font-headoh);
    font-size:150px;
    line-height:1;
}
.prize-number span{
    font-size:11px;
}
.prize-spark{
    position:absolute;
    right:-30px;
    bottom:-60px;
    font-size:230px;
    color:var(--regen-surface);
    line-height:1;
    rotate:12deg
}
.cash-prize{
    background:var(--regen-coral-soft)
}
.cash-value{
    font-family:var(--font-headoh);
    font-size:clamp(38px,4vw,58px);
    line-height:1.1;
    margin-top:28px
}
.cash-value span{
    font-family:Arial;
    font-size:15px;
    margin-left:10px;
}
.prize-note{
    font-size:12px;
    line-height:1.8;
    margin-top:20px!important;
    color:var(--regen-muted)
}
.prize-note span{
    margin-right:6px
}
.steps-section{
    background:var(--regen-surface);
    scroll-margin-top:90px
}
.section-description{
    max-width:300px;
    font-size:15px;
    line-height:1.8
}
.steps-grid{
    list-style:none;
    padding:0;
    margin:0;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px
}
.step-card{
    background:var(--paper);
    padding:22px;
    border:1px solid var(--regen-ink-a1a);
    border-radius:12px
}
.step-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid var(--regen-ink-a20);
    padding-bottom:14px
}
.step-top>span{
    font-size:9px;
    font-weight:bold;
}
.step-top strong{
    font-family:var(--font-headoh);
    font-size:24px;
    color:var(--regen-muted);
}
.step-image{
    margin:15px 0;
    aspect-ratio:1;
    display:flex;
    align-items:center;
    justify-content:center;
}
.step-image img{
    width:100%;
    height:auto;
    object-fit:contain;
}
.step-card h3{
    font-size:23px;
    margin-bottom:12px;
    color:var(--regen-ink)
}
.step-card>p{
    font-size: 13px;
    line-height: 1.75;
}
.keep-packaging{
    display:flex;
    align-items:center;
    gap:22px;
    border:1px solid var(--regen-ink-a30);
    border-radius:12px;
    padding:25px;
    margin-top:28px
}
.keep-icon{
    flex-shrink:0;
    width:43px;
    height:43px;
    border:1px solid var(--ink);
    border-radius:50%;
    text-align:center;
    font-size:28px;
    font-family:var(--font-headoh)
}
.keep-packaging h3{
    font-size:19px;
    margin-bottom:7px;
    color:var(--regen-ink);
}
.keep-packaging p{
    font-size:13px;
    line-height:1.7;
    max-width:650px
}
.keep-packaging a{
    font-size:12px;
    font-weight:bold;
    flex-shrink:0;
    margin-left:auto;
    text-underline-offset:5px
}
.faq-section{
    display:grid;
    grid-template-columns:.85fr 1.3fr;
    gap:6vw;
    align-items:start;
    scroll-margin-top:80px
}
.faq-heading h2{
    font-size:clamp(32px,3vw,45px)
}
.faq-heading>p:last-of-type{
    font-size:15px;
    line-height:1.8;
    margin-top:24px
}
.faq-decoration{
    display:block;
    font-family:var(--font-headoh);
    font-size:130px;
    color:var(--regen-surface);
    line-height:1;
    margin-top:35px;
    rotate:-12deg;
    width:100px
}
.faq-panel{
    min-width:0
}
.faq-panel :global([data-slot="accordion"]){
    border:0;
    border-radius:0;
    gap:14px;
    max-width:none
}
.faq-panel :global([data-slot="accordion-item"]){
    border:1px solid var(--regen-ink-a25);
    border-radius:12px;
    background:white;
    overflow:hidden
}
.faq-panel :global([data-slot="accordion-trigger"]){
    padding:23px;
    font-size:16px;
    color:var(--ink);
    line-height:1.5;
    align-items:center
}
.faq-panel :global([data-slot="accordion-trigger"]:focus-visible){
    outline:3px solid var(--regen-muted);
    outline-offset:-4px
}
.faq-panel :global([data-slot="accordion-content"]){
    padding:0 23px;
    font-size:14px;
    line-height:1.85;
    color:var(--regen-muted)
}
.faq-panel :global(li){
    margin-bottom:10px
}
.closing-section{
    padding:50px 6vw;
    background:var(--lime);
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:35px
}
.closing-section h2{
    font-size:clamp(28px,3vw,43px);
    margin-top:16px
}
.closing-section .promo-button{
    flex-shrink:0
}
 @media(min-width:1600px){
    .section-pad,.code-section,.closing-section{
        padding-left:max(6vw,calc((100vw - 1400px)/2));
        padding-right:max(6vw,calc((100vw - 1400px)/2))
    }
}
 @media(max-width:1050px){
    .steps-grid{
        grid-template-columns:repeat(2,1fr)
    }
    .step-image{
        max-width:230px;
        margin:15px auto
    }
    .period{
        padding:14px
    }
    .section-heading{
        gap:25px
    }
    .prize-card{
        padding:25px
    }
    .prize-card h3{
        font-size:25px
    }
    .prize-number strong{
        font-size:115px
    }
    .keep-packaging{
        flex-wrap:wrap
    }
    .keep-packaging a{
        margin-left:65px
    }
    .faq-section{
        grid-template-columns:1fr;
        gap:30px
    }
    .faq-decoration{
        display:none
    }
    .faq-heading>p:last-of-type{
        max-width:550px
    }
}
 @media(max-width:700px){
    .section-pad{
        padding:52px 6vw
    }
    .code-section{
        grid-template-columns:1fr;
        padding:40px 6vw;
        gap:28px
    }
    .code-copy h1{
        font-size:32px
    }
    .code-action{
        align-items:flex-start
    }
    .code-action .domain{
        margin-left:25px
    }
    .code-action .text-link{
        margin-top:20px
    }
    .section-heading{
        align-items:flex-start;
        flex-direction:column;
        gap:25px;
        margin-bottom:28px
    }
    .section-heading h2{
        font-size:34px
    }
    .period{
        width:100%
    }
    .prize-grid{
        grid-template-columns:1fr;
        gap:16px
    }
    .prize-card{
        min-height:250px;
        padding:25px
    }
    .prize-card h3{
        font-size:25px
    }
    .umroh-prize{
        gap:12px
    }
    .prize-number strong{
        font-size:90px
    }
    .prize-number span{
        font-size:9px
    }
    .cash-value{
        font-size:48px
    }
    .steps-grid{
        gap:12px
    }
    .step-card{
        padding:15px
    }
    .step-card h3{
        font-size:20px
    }
    .step-card>p{
        font-size:12px
    }
    .step-top strong{
        font-size:21px
    }
    .step-top>span{
        font-size:8px
    }
    .keep-packaging{
        padding:20px;
        gap:15px
    }
    .keep-packaging>div{
        flex:1;
        min-width:180px
    }
    .keep-packaging a{
        margin-left:0
    }
    .keep-packaging h3{
        font-size:18px
    }
    .faq-heading h2{
        font-size:34px
    }
    .faq-panel :global([data-slot="accordion-trigger"]){
        padding:20px;
        font-size:15px
    }
    .faq-panel :global([data-slot="accordion-content"]){
        padding:0 20px;
        font-size:13px
    }
    .closing-section{
        padding:38px 6vw;
        flex-direction:column;
        align-items:flex-start;
        gap:25px
    }
    .closing-section h2{
        font-size:30px
    }
}
 @media(max-width:380px){
    .steps-grid{
        grid-template-columns:1fr
    }
    .step-image{
        max-width:210px
    }
    .prize-number strong{
        font-size:72px
    }
    .prize-card h3{
        font-size:22px
    }
}
 @media(prefers-reduced-motion:reduce){
    .promo-button{
        transition:none
    }
    .promo-button:hover{
        transform:none
    }
}
</style>
