---
import LogoRegenWhite from "../assets/icons/logo-regen-white.svg";
import { socialLink } from "@/lib/const.web";
import "../styles/footer.css";
const explore = [
  { title: "Beranda", url: "/" },
  { title: "Tentang REGEN", url: "/tentang-regen" },
  { title: "Blog", url: "/blog" },
  { title: "Hadiah Umroh", url: "/regen-berhadiah-umroh" },
  { title: "Temukan REGEN", url: "/temukan-regen" },
];
const products = [
  { title: "Semua produk", url: "/product" },
  { title: "REGEN 300ml", url: "/product/regen-300ml" },
  { title: "REGEN 450ml", url: "/product/regen-450ml" },
];
---

<footer class="regen-footer">
  <div class="rf-wrap">
    <div class="rf-intro">
      <div><p class="rf-eyebrow">SEGARNYA LANJUT TERUS.</p><h2>Minuman Vitamin<br /><span>#BebasGula.</span></h2></div>
      <a class="rf-partner" href="/jadi-reseller-regen"><span><small>TUMBUH BERSAMA REGEN</small><strong>Jadi mitra kami.</strong></span><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg></a>
    </div>
    <div class="rf-grid">
      <div class="rf-company">
        <a class="rf-logo" href="/" aria-label="REGEN — Beranda"><LogoRegenWhite aria-hidden="true" /></a>
        <p class="rf-company-name">PT Global Enak Nikmat</p>
        <address>Jl. K.S. Tubun No.81B, RT.9/RW.5, Slipi, Kec. Palmerah, Kota Jakarta Barat, Daerah Khusus Ibukota Jakarta 11410</address>
      </div>
      <nav aria-label="Jelajahi REGEN"><h3>JELAJAHI</h3><ul>{explore.map(link => <li><a href={link.url}>{link.title}</a></li>)}</ul></nav>
      <nav aria-label="Produk REGEN"><h3>PILIH KESEGARANMU</h3><ul>{products.map(link => <li><a href={link.url}>{link.title}</a></li>)}<li><a href="https://shopee.co.id/regendrink" target="_blank" rel="noopener noreferrer" aria-label="Belanja di Shopee (buka tab baru)">Belanja di Shopee <span aria-hidden="true">↗</span></a></li></ul></nav>
      <div class="rf-social"><h3>TETAP TERHUBUNG</h3><p>Cerita segar setiap hari.<br />Ikuti <a class="hover:underline text-orange-400" href="https://www.instagram.com/drinkregenid/" target="_blank" rel="noopener noreferrer">@drinkregenid</a>.</p><div class="rf-social-links">{socialLink.map(({url, icon: Icon, label}) => <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`${label} REGEN (buka tab baru)`}><Icon aria-hidden="true" /></a>)}</div></div>
    </div>
    <div class="rf-bottom"><p>© {new Date().getFullYear()} REGEN. All rights reserved.</p><span>MINUMAN BERVITAMIN · BEBAS GULA</span></div>
  </div>
  <div class="rf-color-strip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
</footer>
