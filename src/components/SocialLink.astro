---

import InstagramIcon from "../assets/icons/brand-instagram.svg"
import TiktokIcon from "../assets/icons/brand-tiktok.svg"
import YoutubeIcon from "../assets/icons/brand-youtube.svg"

interface SocialLinkPropss {
  className?: string;
}

const { className } = Astro.props as SocialLinkPropss;
---

<div class={className}>
  <div class="grid grid-cols-3 gap-2 justify-center w-full">
    <a class="flex items-center justify-center hover:scale-110 hover:-translate-y-2 transition-all" 
    href="https://www.instagram.com/drinkregenid/" 
    target="_blank" 
    aria-label="link to instagram account"
    rel="noopener noreferrer">
      <InstagramIcon class="size-16" />
    </a>
    <a class="flex items-center justify-center hover:scale-110 hover:-translate-y-2 transition-all" 
    href="https://www.tiktok.com/@drinkregenid" 
    target="_blank" 
    aria-label="link to tiktok account"
    rel="noopener noreferrer">
      <TiktokIcon class="size-16" />
    </a>
    <a class="flex items-center justify-center hover:scale-110 hover:-translate-y-2 transition-all" 
    href="https://www.youtube.com/@drinkregenid" 
    target="_blank"
    aria-label="link to youtube account" 
    rel="noopener noreferrer">
      <YoutubeIcon class="size-16" />
    </a>
  </div>
</div>
