---
const stores = [
  { name: "Indomaret", image: "/store/indomaret.svg" },
  { name: "Alfamart", image: "/store/alfamart.svg" },
  { name: "Alfamidi", image: "/store/alfamidi.svg" },
  { name: "FamilyMart", image: "/store/familymart.svg" },
];
---

<section class="buy-regen" aria-label="Belanja REGEN">
  <div class="buy-regen-card">
    <div class="buy-regen-copy">
      <span class="buy-regen-eyebrow"><span></span> KESEGARAN TINGGAL SELANGKAH</span>
      <h2>Stok segarnya.<br />Nikmati <em>harinya.</em></h2>
      <p>Rasa buah favorit, vitamin harian, dan manisnya yang bebas gula. Siap menemani aktivitasmu? Dapatkan REGEN di Shopee.</p>
      <a class="buy-regen-cta" href="https://shopee.co.id/regendrink" target="_blank" rel="noopener noreferrer" aria-label="Belanja REGEN di Shopee (buka tab baru)">
        <span>Belanja di Shopee</span>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" /></svg>
      </a>
      <a class="buy-regen-explore" href="/product">Kenali semua varian <span aria-hidden="true">↗</span></a>
    </div>
    <div class="buy-regen-visual">
      <div class="buy-regen-orbit" aria-hidden="true"></div>
      <span class="buy-regen-word" aria-hidden="true">SEGAR!</span>
      <div class="buy-regen-stamp"><strong>0</strong><span>GULA & KALORI</span></div>
      <img src="/hand-hold-regen.webp" width="1200" height="656" loading="lazy" decoding="async" alt="Tiga tangan mengangkat REGEN varian Apple, Lemon Lime, dan Watermelon" />
      <span class="buy-regen-note">MINUMAN VITAMIN #BEBASGULA.</span>
    </div>
  </div>
  <div class="buy-regen-retail">
    <div class="buy-regen-retail-copy"><span>LEBIH DEKAT DENGANMU</span><p>Juga ada di toko favoritmu.</p></div>
    <ul aria-label="Tersedia di retail">{stores.map(store => <li><img src={store.image} alt={store.name} width="112" height="40" loading="lazy" /></li>)}</ul>
    <a href="/temukan-regen">Temukan REGEN <span aria-hidden="true">↗</span></a>
  </div>
</section>

<style>
  .buy-regen{padding:64px 24px;background:var(--regen-paper);color:var(--regen-ink)}
  .buy-regen-card{max-width:1392px;margin:auto;display:grid;grid-template-columns:1fr 1fr;background:var(--regen-ink);border-radius:32px;overflow:hidden}
  .buy-regen-copy{padding:64px 56px;position:relative;z-index:1;color:var(--regen-paper)}
  .buy-regen-eyebrow{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:750;letter-spacing:.13em;color:var(--regen-citrus)}
  .buy-regen-eyebrow>span{width:8px;height:8px;border-radius:50%;background:currentColor;flex-shrink:0}
  h2{font-family:var(--font-headoh);font-size:clamp(58px,6.6vw,96px);font-weight:400;line-height:.98;letter-spacing:-.015em;margin:28px 0 23px}
  h2 em{font-style:normal;color:var(--regen-citrus)}
  .buy-regen-copy p{font-size:15px;line-height:1.8;max-width:390px;margin:0 0 30px;color:var(--regen-border)}
  .buy-regen-cta{display:flex;align-items:center;justify-content:space-between;gap:36px;width:fit-content;background:var(--regen-citrus);color:var(--regen-ink);padding:18px 23px;border-radius:999px;font-size:14px;font-weight:750;text-decoration:none;transition:background .2s,transform .2s}
  .buy-regen-cta:hover{background:var(--regen-yellow);transform:translateY(-3px)}
  .buy-regen-explore{display:flex;align-items:center;gap:20px;width:fit-content;margin-top:20px;font-size:12px;color:var(--regen-paper);text-underline-offset:5px}
  .buy-regen a:focus-visible{outline:3px solid var(--regen-green);outline-offset:5px}
  .buy-regen-visual{position:relative;isolation:isolate;min-height:520px;overflow:hidden;background:var(--regen-citrus)}
  .buy-regen-orbit{position:absolute;width:560px;aspect-ratio:1;border:1px solid var(--regen-olive);border-radius:50%;top:10%;left:12%;opacity:.4;box-shadow:0 0 0 48px color-mix(in srgb,var(--regen-olive) 15%,transparent),0 0 0 96px color-mix(in srgb,var(--regen-olive) 10%,transparent)}
  .buy-regen-word{position:absolute;top:24px;left:26px;font-family:var(--font-headoh);font-size:clamp(110px,13vw,185px);line-height:1;color:var(--regen-cream);transform:rotate(-8deg)}
  .buy-regen-visual>img{position:absolute;width:118%;max-width:none;height:auto;bottom:0;left:-9%;z-index:1}
  .buy-regen-stamp{position:absolute;right:26px;top:30px;width:94px;height:94px;background:var(--regen-yellow);border:1px solid var(--regen-ink);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:rotate(12deg);z-index:2}
  .buy-regen-stamp strong{font-family:var(--font-headoh);font-size:46px;line-height:1;font-weight:400}.buy-regen-stamp span{font-size:10px;font-weight:800;letter-spacing:.18em}
  .buy-regen-note{position:absolute;bottom:22px;left:50%;transform:translateX(-50%) rotate(-3deg);white-space:nowrap;background:var(--regen-paper);padding:12px 16px;font-size:16px;font-weight:800;letter-spacing:.05em;z-index:2;border-radius:6px}
  .buy-regen-retail{max-width:1280px;margin:32px auto 0;display:flex;align-items:center;justify-content:space-between;gap:28px}
  .buy-regen-retail-copy>span{font-size:8px;font-weight:800;letter-spacing:.13em;color:var(--regen-muted)}.buy-regen-retail-copy p{font-size:13px;margin:7px 0 0}
  .buy-regen-retail ul{display:flex;align-items:center;gap:26px;list-style:none;margin:0;padding:0}.buy-regen-retail li img{width:95px;height:40px;object-fit:contain}
  .buy-regen-retail>a{font-size:12px;font-weight:750;color:var(--regen-ink);text-underline-offset:5px;white-space:nowrap}.buy-regen-retail>a span{margin-left:12px}
  @media(max-width:1100px){.buy-regen-copy{padding:48px 32px}.buy-regen-retail{flex-wrap:wrap}.buy-regen-retail ul{gap:20px}.buy-regen-visual{min-height:480px}}
  @media(max-width:700px){.buy-regen{padding:40px 16px}.buy-regen-card{grid-template-columns:1fr;border-radius:24px}.buy-regen-copy{padding:36px 26px}.buy-regen-eyebrow{font-size:8px}h2{font-size:64px;margin:25px 0 20px}.buy-regen-copy p{font-size:14px}.buy-regen-visual{min-height:340px}.buy-regen-visual>img{width:108%;left:-4%}.buy-regen-word{font-size:125px;top:20px}.buy-regen-stamp{width:78px;height:78px;right:20px;top:20px}.buy-regen-stamp strong{font-size:38px}.buy-regen-retail{gap:22px;margin-top:26px}.buy-regen-retail-copy{width:100%}.buy-regen-retail ul{width:100%;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.buy-regen-retail li img{width:100%;height:32px}.buy-regen-note{font-size:8px;padding:10px 12px}}
  @media(prefers-reduced-motion:reduce){.buy-regen-cta{transition:none}.buy-regen-cta:hover{transform:none}}
</style>
