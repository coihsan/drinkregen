---
import LogoRegenWhite from "../assets/icons/logo-regen-white.svg";

interface ChannelMarketType {
  alt: string;
  image: string
}

const ChannelMarketOffline : ChannelMarketType[] = [
  {
    alt: "alfamart",
    image: "/store/alfamart.svg"
  },
  {
    alt: "indomaret",
    image: "/store/indomaret.svg"
  },
  {
    alt: "alfamidi",
    image: "/store/indomaret.svg"
  },
  {
    alt: "familymart",
    image: "/store/familymart.svg"
  },
  {
    alt: "harihari",
    image: "/store/harihari.svg"
  },
  {
    alt: "k3mart",
    image: "/store/k3mart.svg"
  },
  {
    alt: "circlek",
    image: "/store/circle-k.svg"
  },
  {
    alt: "indogrosir",
    image: "/store/indogrosir.svg"
  }
]
---

<section
  class="relative overflow-hidden flex items-center justify-center bg-[#27C00C] w-full min-h-[600px]"
>
  <div class="">
    <div
      class="absolute top-10 z-20 left-0 lg:max-w-2xl flex flex-col p-6 flex-col items-center md:items-start lg:items-start justify-start"
    >
      <h2
        class="font-bold text-white leading-tight text-5xl md:text-7xl text-center md:text-start lg:text-start"
      >
        Dapatkan{" "}
        <img
          class="inline-block h-[0.9em] w-auto align-middle"
          src={LogoRegenWhite.src}
        />
        {" "}
        di Shopee
      </h2>
      <div class="mt-6 group">
        <a
          class="bg-white w-fit rounded-full flex shadow-lg items-center gap-2 px-8 py-4"
          href={"https://shopee.co.id/regendrink"}
          target="_blank"
        >
          <img
            class="k"
            src="/store/shopee.svg"
            alt="Banner Buy Regen"
            width={140}
            height={40}
          />
        </a>
      </div>
    </div>
    <img
      class="flex-1 object-fit absolute bottom-0 right-0 z-20"
      src={"/hand-hold-regen.webp"}
      width={900}
      height={600}
      alt=""
    />
  </div>
  <img
    class="object-cover object-center opacity-10 absolute inset-0 w-full h-full z-1"
    src="/thunderbolt.svg"
    alt="pattern"
  />
</section>
